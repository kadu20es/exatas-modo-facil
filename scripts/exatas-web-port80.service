[Unit]
Description=Exatas local learning site on HTTP port 80
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=caduzera
Group=caduzera
WorkingDirectory=/home/caduzera/exatas-react
Environment=PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/home/caduzera/.nvm/versions/node/v26.13.0/bin/node /home/caduzera/exatas-react/scripts/serve-dist.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
